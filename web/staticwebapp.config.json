{
  "routes": [
    {
      "route": "/pitch",
      "rewrite": "/pitch.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/pitch.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/present",
      "rewrite": "/present.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/present.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/login.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/choose.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/choose/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/map/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/app.css",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/supervisor.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/common.js",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login.html",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}